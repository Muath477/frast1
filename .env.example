ROOTIQ_MODE=sim                      # sim | live
DATABASE_URL=postgresql+psycopg://rootiq:rootiq@localhost:5432/rootiq
TOPOLOGY_PATH=../configs/topology.json
LAYOUT_PATH=../configs/layout.json
INGEST_TOKEN=change-me-ingest   # also protects POST /api/syslog (multi-vendor syslog ingestion)
LAB_AGENT_URL=http://127.0.0.1:9000
LAB_AGENT_TOKEN=change-me-agent
RECORD_EVENTS=0
# --- optional LLM wording layer (everything works without it) ---
LLM_ENABLED=0
LLM_PROVIDER=custom          # anthropic | gemini | groq | custom
LLM_MODEL=openai/gpt-4o-mini # empty = provider default; for OpenRouter set a model id
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# provider=custom: OpenAI-compatible server (OpenRouter, Ollama, vLLM, HF…)
# OpenRouter example:
#   LLM_ENABLED=1
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   CUSTOM_LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
# --- multi-agent layer ---
ROOTIQ_EXECUTION_ENABLED=1     # 0 = live-lab remediation becomes a dry run
AGENT_TIMEOUT_S=8
GUARDRAIL_MAX_EXECUTIONS=5     # per 5 minutes
RAG_MIN_SCORE=0.10
# KB_ROOT=                   # folder containing docs/ and lab/configs (auto-detected)
