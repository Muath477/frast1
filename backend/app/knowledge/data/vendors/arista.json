      "version_regex": "Software image version:\\s*(?P<version>\\d+\\.\\d+\\.\\d+[A-Za-z]*)",
      "version_scheme": "MAJOR.MINOR.PATCH + suffix, e.g. 4.30.5M (M = maintenance/long-term train, F = feature release).",
      "examples": {
        "sysdescr": [
          "Arista Networks EOS version 4.30.5M running on an Arista Networks DCS-7050SX3-48YC8"
        ],
        "version": [
          "4.30.5M",
          "4.32.1F"
        ]
      }
    }
