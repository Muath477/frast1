      "version_regex": "(?:Junos|JUNOS)[^\\n]*?:\\s*(?P<version>\\d+\\.\\d+[RXSFDI]\\d+(?:-[A-Z]\\d+)?(?:\\.\\d+)?)",
      "version_scheme": "YY.QRn[-Sn.n]: release year.quarter, R = release, then respin (R3) and service release (-S5.4), e.g. 21.4R3-S5.4. Commonly one release per quarter; EX/QFX trains follow the same scheme.",
      "examples": {
        "sysdescr": [
          "Juniper Networks, Inc. ex4300-48t Ethernet Switch, kernel JUNOS 21.4R3-S5.4, Build date: 2023-06-01 10:00:00 UTC Copyright (c) 1996-2023 Juniper Networks, Inc."
        ],
        "version": [
          "21.4R3-S5.4",
          "23.2R2"
        ]
      }
    }
