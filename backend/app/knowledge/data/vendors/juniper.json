  "syslog": [
    {
      "id": "link-trap",
      "regex": "SNMP_TRAP_LINK_(?P<state>DOWN|UP):.*?ifName (?P<interface>\\S+)",
      "event": "interface_state",
      "severity": "warning",
      "example": "mib2d[1234]: SNMP_TRAP_LINK_DOWN: ifIndex 513, ifAdminStatus up(1), ifOperStatus down(2), ifName ge-0/0/0"
    },
    {
      "id": "ospf-nbrdown",
      "regex": "RPD_OSPF_NBRDOWN:\\s*OSPF neighbor (?P<neighbor>[\\d.]+) \\(.*? (?P<interface>\\S+) area \\S+\\) state changed from (?P<from_state>\\w+) to (?P<to_state>\\w+)",
      "event": "ospf_neighbor_change",
      "severity": "warning",
      "example": "rpd[500]: RPD_OSPF_NBRDOWN: OSPF neighbor 10.0.0.2 (realm ospf-v2 ge-0/0/1.0 area 0.0.0.0) state changed from Full to Down due to KillNbr (event reason: interface went down)"
    },
    {
      "id": "bgp-state",
      "regex": "RPD_BGP_NEIGHBOR_STATE_CHANGED:\\s*BGP peer (?P<neighbor>\\S+) \\(.*?\\) changed state from (?P<from_state>\\w+) to (?P<to_state>\\w+)",
      "event": "bgp_neighbor_change",
      "severity": "warning",
      "example": "rpd[500]: RPD_BGP_NEIGHBOR_STATE_CHANGED: BGP peer 10.1.1.1 (External AS 65001) changed state from Established to Idle (event HoldTime)"
    }
  ],
